{
  "name": "@fomapay/react-native",
  "version": "0.1.0",
  "description": "SDK React Native officiel de FomaPay : fenêtre de paiement FomaPay Direct (QR code) et Mobile Money pour iOS et Android.",
  "license": "MIT",
  "keywords": ["fomapay", "react-native", "expo", "payments", "mobile money", "m-pesa", "orange money", "airtel money", "rdc"],
  "repository": { "type": "git", "url": "https://github.com/fomapay/fomapay-react-native.git" },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "react-native": "^0.81.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0"
  }
}
